# The build stages need the Go and web source and nothing else. Everything
# below either bloats the context or invalidates the layer cache on an
# unrelated edit.
.git
.github
.golangci.yml
adr
docs
Dockerfile
Makefile
*.md

# The image builds the UI itself, so a local build's output and dependencies
# would only be shadowed by it.
web/node_modules
web/dist
